# Copy to .env and fill in values before `docker compose up --build`
#   cp .env.docker.example .env

# ── Public URL (Caddy) ─────────────────────────────────────────
# Caddy listens on :80 by default (see Caddyfile).
# For HTTPS later, edit Caddyfile to use your domain instead of :80.

# ── Required for the public site (homepage + contact form) ─────
# Compose MySQL — use simple passwords (letters/numbers/hyphen). Avoid # " ' $ and spaces.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=nuevetech
MYSQL_USER=nuevetech
MYSQL_PASSWORD=changeme

# Host must be "db" (the Compose service name), NOT localhost
DATABASE_URL=mysql://nuevetech:changeme@db:3306/nuevetech

# Set to 0 after first successful schema sync if you prefer
RUN_DB_PUSH=1

# ── Optional: only needed for /login and /admin (Kimi OAuth CMS) ─
# Leave blank to run the public marketing site like nuevetech.io
APP_ID=
APP_SECRET=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=
