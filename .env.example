# ── Database (required for contact form / CMS data) ────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Optional: Kimi OAuth (only for /login and /admin) ──────────
# Leave blank to run the public marketing site without admin login.
APP_ID=
APP_SECRET=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# For Docker / Lightsail, copy .env.docker.example → .env and see DEPLOY.md
